#!/usr/bin/env bash

# Cores para feedback visual no terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # Sem cor

echo -e "\n${BLUE}🔍 [Pre-commit Hook] Iniciando validações de qualidade do código...${NC}\n"

# ------------------------------------------------------------------------------
# 0. Garantir que o Flutter está no PATH
# ------------------------------------------------------------------------------
# Fora do terminal do VS Code o Flutter pode não estar no PATH; sem esta
# checagem, o passo 1 falharia com uma mensagem enganosa de formatação.
if ! command -v flutter >/dev/null 2>&1; then
  echo -e "${RED}❌ Comando 'flutter' não encontrado no PATH.${NC}"
  echo -e "${YELLOW}💡 Dica: faça o commit pelo terminal do VS Code ou rode 'export PATH=\"\$HOME/flutter/bin:\$PATH\"'.${NC}\n"
  exit 1
fi

# ------------------------------------------------------------------------------
# 1. Identificar arquivos Dart em stage (staged)
# ------------------------------------------------------------------------------
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.dart$')

if [ -z "$STAGED_DART_FILES" ]; then
  echo -e "${YELLOW}ℹ Nenhum arquivo Dart modificado para validar.${NC}"
  exit 0
fi

# ------------------------------------------------------------------------------
# 2. Validação de Formatação (dart format)
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [1/3] Verificando formatação do código (dart format)...${NC}"

# --set-exit-if-changed retorna código 1 se algum arquivo não estiver formatado
dart format --output=none --set-exit-if-changed $STAGED_DART_FILES

if [ $? -ne 0 ]; then
  echo -e "\n${RED}❌ Erro de formatação detectado!${NC}"
  echo -e "${YELLOW}💡 Dica: Execute 'dart format .' e adicione os arquivos novamente com 'git add'.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✔ Formatação válida.${NC}"

# ------------------------------------------------------------------------------
# 3. Análise Estática Estrita (flutter analyze)
# ------------------------------------------------------------------------------
echo -e "\n${BLUE}▶ [2/3] Executando análise estática (flutter analyze)...${NC}"

flutter analyze

if [ $? -ne 0 ]; then
  echo -e "\n${RED}❌ O analisador estático encontrou erros ou violações de lint!${NC}"
  echo -e "${YELLOW}💡 Dica: Corrija os avisos do 'analysis_options.yaml' antes de commitar.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✔ Análise estática aprovada (zero warnings/erros).${NC}"

# ------------------------------------------------------------------------------
# 4. Verificação de complexidade de código
# ------------------------------------------------------------------------------
echo -e "\n${BLUE}▶ [3/3] Verificando complexidade do código (dart_code_linter)...${NC}"
dart run dart_code_linter:metrics analyze $STAGED_DART_FILES --set-exit-on-violation-level=warning
if [ $? -ne 0 ]; then
  echo -e "\n${RED}❌ Violação de complexidade ou aninhamento excessivo detectada!${NC}"
  echo -e "${YELLOW}💡 Dica: Reduza o aninhamento de loops/ifs ou divida a função em partes menores.${NC}\n"
  exit 1
fi
echo -e "${GREEN}✔ Métricas de complexidade aprovadas.${NC}"
